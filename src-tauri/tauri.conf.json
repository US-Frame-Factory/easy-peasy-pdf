{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy Peasy PDF",
  "version": "0.1.0",
  "identifier": "com.usframefactory.easypeasypdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Easy Peasy PDF",
        "width": 1400,
        "height": 900,
        "minWidth": 640,
        "minHeight": 400,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: tile: http://tile.localhost; connect-src 'self' ipc: http://ipc.localhost tile: http://tile.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["pdfium/*"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "shortDescription": "Fast viewer for big construction plan sets",
    "publisher": "US Frame Factory",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
